PROJECT_NAME="Role-Based AI Candidate Screening System"
VERSION="1.0.0"
API_PREFIX="/api"

# Database & Vector DB paths
DATABASE_URL="sqlite:///./data/screening.db"
CHROMA_PERSIST_DIR="./data/chroma_db"

# LLM Provider: 'auto', 'openai', 'gemini', or 'local'
# If API keys are left blank, the system automatically runs the high-performance local semantic engine
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

QUESTIONS_PER_SESSION=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RAG_TOP_K=3
